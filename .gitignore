
# Compiled output — Maven regenerates this on every build
target/

# Compiled class files (in case they end up outside target/)
*.class

# Never commit built artifacts
*.jar
*.war

# IDE project files — personal to each developer's machine
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# OS junk files
.DS_Store
Thumbs.db

# Logs generated at runtime
*.log

# Environment/secrets files if you ever add one
.env
